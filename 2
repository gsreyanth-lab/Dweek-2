/*
 * weka_c.c : Data preprocessing + Apriori association rules in plain C
 * Mirrors WEKA's Normalize, Discretize, Resample, Remove filters and Apriori.
 *
 * Compile: gcc -O2 -o weka_c weka_c.c -lm
 * Run    : ./weka_c
 */
#include <stdio.h>
#include <stdlib.h>
#include <string.h>

/* ====================== PART 1: PREPROCESSING ====================== */
/* weather.numeric: temperature, humidity (14 instances) */
#define N 14
static double temp[N]  = {85,80,83,70,68,65,64,72,69,75,75,72,81,71};
static double humid[N] = {85,90,86,96,80,70,65,95,70,80,70,90,75,91};
static const char *play[N] = {"no","no","yes","yes","yes","no","yes",
                              "no","yes","yes","yes","yes","yes","no"};

static void min_max(const double *a, int n, double *mn, double *mx) {
    *mn = *mx = a[0];
    for (int i = 1; i < n; i++) {
        if (a[i] < *mn) *mn = a[i];
        if (a[i] > *mx) *mx = a[i];
    }
}

/* Normalize: (x - min) / (max - min)  -> [0,1] */
static void normalize_demo(void) {
    double mn, mx;
    min_max(temp, N, &mn, &mx);
    printf("Normalize (temperature)  min=%.0f max=%.0f\n", mn, mx);
    for (int i = 0; i < 3; i++)
        printf("  %.0f -> %.4f\n", temp[i], (temp[i] - mn) / (mx - mn));
}

/* Discretize: equal-width binning into `bins` intervals */
static void discretize_demo(int bins) {
    double mn, mx;
    min_max(temp, N, &mn, &mx);
    double w = (mx - mn) / bins;
    printf("\nDiscretize (temperature, %d equal-width bins, width=%.3f)\n", bins, w);
    for (int b = 0; b < bins; b++)
        printf("  bin %d: (%.3f - %.3f]\n", b, mn + b * w, mn + (b + 1) * w);
    for (int i = 0; i < N; i++) {
        int b = (int)((temp[i] - mn) / w);
        if (b >= bins) b = bins - 1;          /* max value goes to last bin */
        printf("  temp=%.0f -> bin %d%s", temp[i], b, (i % 4 == 3) ? "\n" : "   ");
    }
    printf("\n");
}

/* Resample: random 50% subsample WITHOUT replacement (Fisher-Yates) */
static void resample_demo(int percent) {
    int idx[N];
    for (int i = 0; i < N; i++) idx[i] = i;
    srand(1);
    for (int i = N - 1; i > 0; i--) {
        int j = rand() % (i + 1);
        int t = idx[i]; idx[i] = idx[j]; idx[j] = t;
    }
    int k = N * percent / 100;
    printf("\nResample %d%% without replacement: %d of %d instances\n  rows:", percent, k, N);
    for (int i = 0; i < k; i++) printf(" %d", idx[i] + 1);
    printf("\n");
}

/* Remove: drop the class attribute (column) when printing */
static void remove_demo(void) {
    printf("\nRemove attribute 'play' -> remaining columns (temperature,humidity):\n");
    for (int i = 0; i < 3; i++)
        printf("  %.0f,%.0f      (removed: %s)\n", temp[i], humid[i], play[i]);
}

/* ====================== PART 2: APRIORI ====================== */
#define NATTR   5
#define NITEMS 12
static const char *attr_name[NATTR] = {"outlook","temperature","humidity","windy","play"};
/* items grouped by attribute */
static const char *item_name[NITEMS] = {
    "outlook=sunny","outlook=overcast","outlook=rainy",
    "temperature=hot","temperature=mild","temperature=cool",
    "humidity=high","humidity=normal",
    "windy=TRUE","windy=FALSE",
    "play=yes","play=no"};
static const int item_attr[NITEMS] = {0,0,0,1,1,1,2,2,3,3,4,4};

/* weather.nominal.arff : each row = list of item ids */
static const int data[N][NATTR] = {
    {0,3,6,9,11},{0,3,6,8,11},{1,3,6,9,10},{2,4,6,9,10},{2,5,7,9,10},
    {2,5,7,8,11},{1,5,7,8,10},{0,4,6,9,11},{0,5,7,9,10},{2,4,7,9,10},
    {0,4,7,8,10},{1,4,6,8,10},{1,3,7,9,10},{2,4,6,8,11}};

typedef unsigned int Mask;
static Mask trans[N];

static int count(Mask m) {                    /* support count of itemset */
    int c = 0;
    for (int t = 0; t < N; t++) if ((trans[t] & m) == m) c++;
    return c;
}
static int popcnt(Mask m) { int c = 0; while (m) { c += m & 1; m >>= 1; } return c; }

static int valid(Mask m) {                    /* at most one value per attribute */
    int seen[NATTR] = {0};
    for (int i = 0; i < NITEMS; i++)
        if (m & (1u << i)) { if (seen[item_attr[i]]++) return 0; }
    return 1;
}

typedef struct { Mask ante, cons; int sup_ante, sup_all; double conf, lift; } Rule;
static Rule rules[100000]; static int nr = 0;
static Mask freq[5000]; static int nf = 0;

static int cmp(const void *a, const void *b) {
    const Rule *x = a, *y = b;
    if (y->conf > x->conf + 1e-9) return 1;
    if (x->conf > y->conf + 1e-9) return -1;
    if (y->sup_all != x->sup_all) return y->sup_all - x->sup_all;
    return popcnt(x->ante | x->cons) - popcnt(y->ante | y->cons);
}

static void print_set(Mask m) {
    for (int i = 0; i < NITEMS; i++) if (m & (1u << i)) printf("%s ", item_name[i]);
}

static void apriori(int min_count, double min_conf, int max_rules) {
    for (int t = 0; t < N; t++) {
        trans[t] = 0;
        for (int a = 0; a < NATTR; a++) trans[t] |= 1u << data[t][a];
    }
    /* level-wise counts of frequent itemsets */
    int L[NATTR + 1] = {0};
    for (Mask m = 1; m < (1u << NITEMS); m++) {
        if (!valid(m)) continue;
        if (count(m) >= min_count) { freq[nf++] = m; L[popcnt(m)]++; }
    }
    printf("\nApriori\n=======\n");
    printf("Minimum support count: %d (%.2f)\nMinimum confidence: %.2f\n\n",
           min_count, (double)min_count / N, min_conf);
    for (int k = 1; k <= NATTR; k++)
        if (L[k]) printf("Size of set of large itemsets L(%d): %d\n", k, L[k]);

    /* generate rules: every non-empty proper subset as antecedent */
    for (int f = 0; f < nf; f++) {
        Mask s = freq[f];
        if (popcnt(s) < 2) continue;
        int sup_all = count(s);
        for (Mask a = (s - 1) & s; a; a = (a - 1) & s) {
            Mask c = s & ~a;
            int sa = count(a), sc = count(c);
            double conf = (double)sup_all / sa;
            if (conf + 1e-9 < min_conf) continue;
            Rule *r = &rules[nr++];
            r->ante = a; r->cons = c; r->sup_ante = sa; r->sup_all = sup_all;
            r->conf = conf;
            r->lift = conf / ((double)sc / N);
        }
    }
    qsort(rules, nr, sizeof(Rule), cmp);

    printf("\nBest rules found (%d total rules, showing top %d):\n\n", nr, max_rules);
    for (int i = 0; i < nr && i < max_rules; i++) {
        printf("%2d. ", i + 1);
        print_set(rules[i].ante);
        printf("%d ==> ", rules[i].sup_ante);
        print_set(rules[i].cons);
        printf("%d    <conf:(%.2f)> lift:(%.2f)\n", rules[i].sup_all, rules[i].conf, rules[i].lift);
    }
}

int main(void) {
    printf("===== PREPROCESSING (weather.numeric) =====\n");
    normalize_demo();
    discretize_demo(3);
    resample_demo(50);
    remove_demo();

    printf("\n===== ASSOCIATION RULES (weather.nominal) =====");
    apriori(2, 0.9, 10);
    return 0;
}
